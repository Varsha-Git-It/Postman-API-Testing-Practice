      "name": "ResponseValidation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response time is below 5 seconds\", () => {\r\n    pm.expect(pm.response.responseTime).to.be.below(5000);\r\n});\r\n\r\npm.test(\"Response contains book records\", () => {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.be.an(\"array\");\r\n});\r\npm.test(\"Every book has a title\", () => {\r\n    const data = pm.response.json();\r\n\r\n    data.forEach((book) => {\r\n        pm.expect(book).to.have.property(\"title\");\r\n    });\r\n});\r\npm.test(\"First book has the expected title\", () => {\r\n    const data = pm.response.json();\r\n    pm.expect(data[0].title).to.equal(\"To Kill a Mockingbird\");\r\n});"
            ]
          }
        }
      ],
