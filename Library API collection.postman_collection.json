            "exec": [
              "pm.test(\"Status code is 400\", () => {\r\n    pm.expect(pm.response.code).to.equal(400);\r\n});\r\n\r\npm.test(\"Error message identifies missing title\", () => {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.message).to.include(\"title\");\r\n});\r\n\r\npm.test(\"Missing property is title\", () => {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.errors[0].params.missingProperty)\r\n        .to.equal(\"title\");\r\n});\r\npm.test(\"Status code is 400\", () => {\r\n    pm.expect(pm.response.code).to.equal(400);\r\n});\r\n\r\npm.test(\"Error identifies yearPublished\", () => {\r\n    const data = pm.response.json();\r\n    pm.expect(data.message).to.include(\"yearPublished\");\r\n});\r\n\r\npm.test(\"Expected data type is integer\", () => {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.errors[0].params.type).to.equal(\"integer\");\r\n});"
            ]
